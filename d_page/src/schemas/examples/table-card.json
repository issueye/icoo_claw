{
  "schemaVersion": "0.1.0",
  "page": {
    "id": "tableCardExample",
    "title": "Table Card"
  },
  "state": {
    "selectedName": ""
  },
  "data": {
    "rows": [
      {
        "id": "pkg",
        "module": "包骨架",
        "status": "基本完成",
        "progress": "85%"
      },
      {
        "id": "runtime",
        "module": "运行时",
        "status": "基本完成",
        "progress": "90%"
      },
      {
        "id": "renderer",
        "module": "渲染器",
        "status": "集成中",
        "progress": "70%"
      }
    ]
  },
  "actions": {
    "selectRow": {
      "type": "setState",
      "payload": {
        "path": "selectedName",
        "value": "{{ context.event.row.module }}"
      }
    }
  },
  "root": {
    "id": "tableRoot",
    "type": "card",
    "kind": "page",
    "layout": {
      "mode": "block",
      "gap": "lg"
    },
    "children": [
      {
        "id": "tableHeading",
        "type": "card",
        "kind": "display",
        "component": {
          "type": "heading",
          "props": {
            "level": 2,
            "text": "模块完成情况",
            "subtitle": "点击表格行可以把所选模块写入 state。"
          }
        }
      },
      {
        "id": "moduleTable",
        "type": "card",
        "kind": "data",
        "title": "MVP 模块",
        "data": {
          "bind": "data.rows",
          "defaultValue": []
        },
        "component": {
          "type": "table",
          "props": {
            "columns": [
              {
                "key": "module",
                "label": "模块"
              },
              {
                "key": "status",
                "label": "状态"
              },
              {
                "key": "progress",
                "label": "进度",
                "align": "right"
              }
            ],
            "caption": "d_page 当前 MVP 状态"
          },
          "events": {
            "rowSelect": "selectRow"
          }
        }
      },
      {
        "id": "selectedRowText",
        "type": "card",
        "kind": "display",
        "visible": "{{ state.selectedName }}",
        "component": {
          "type": "text",
          "props": {
            "tone": "accent",
            "text": "已选择：{{ state.selectedName }}"
          }
        }
      }
    ]
  }
}
