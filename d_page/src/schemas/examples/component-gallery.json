{
  "schemaVersion": "0.1.0",
  "page": {
    "id": "componentGalleryExample",
    "title": "Component Gallery"
  },
  "state": {},
  "data": {},
  "actions": {},
  "root": {
    "id": "componentGalleryRoot",
    "type": "card",
    "kind": "page",
    "layout": {
      "mode": "block",
      "gap": "lg"
    },
    "children": [
      {
        "id": "galleryHeading",
        "type": "card",
        "kind": "display",
        "component": {
          "type": "heading",
          "props": {
            "level": 2,
            "text": "第二批基础组件",
            "subtitle": "状态标签、分隔线、布尔控件和图片降级展示。"
          }
        }
      },
      {
        "id": "gallerySurface",
        "type": "card",
        "kind": "display",
        "component": {
          "type": "cardSurface",
          "props": {
            "title": "组件展示",
            "subtitle": "组件只消费解析后的 props，不直接读取原始 schema。"
          }
        },
        "children": [
          {
            "id": "tagRow",
            "type": "card",
            "kind": "layout",
            "layout": {
              "mode": "flex",
              "gap": "sm"
            },
            "children": [
              {
                "id": "tagSuccess",
                "type": "card",
                "kind": "display",
                "component": {
                  "type": "tag",
                  "props": {
                    "label": "Ready",
                    "tone": "success"
                  }
                }
              },
              {
                "id": "tagWarning",
                "type": "card",
                "kind": "display",
                "component": {
                  "type": "tag",
                  "props": {
                    "label": "Review",
                    "tone": "warning"
                  }
                }
              },
              {
                "id": "tagEmpty",
                "type": "card",
                "kind": "display",
                "component": {
                  "type": "tag",
                  "props": {
                    "emptyText": "Empty tag"
                  }
                }
              }
            ]
          },
          {
            "id": "galleryDivider",
            "type": "card",
            "kind": "display",
            "component": {
              "type": "divider",
              "props": {
                "label": "media"
              }
            }
          },
          {
            "id": "imageGrid",
            "type": "card",
            "kind": "layout",
            "layout": {
              "mode": "grid",
              "columns": 12,
              "gap": "md"
            },
            "children": [
              {
                "id": "emptyImage",
                "type": "card",
                "kind": "display",
                "layout": {
                  "span": 6
                },
                "component": {
                  "type": "image",
                  "props": {
                    "caption": "空状态",
                    "emptyText": "尚未提供图片"
                  }
                }
              },
              {
                "id": "brokenImage",
                "type": "card",
                "kind": "display",
                "layout": {
                  "span": 6
                },
                "component": {
                  "type": "image",
                  "props": {
                    "src": "/missing-d-page-image.png",
                    "alt": "Missing demo image",
                    "caption": "加载失败降级",
                    "errorText": "图片加载失败"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
