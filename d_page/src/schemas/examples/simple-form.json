{
  "schemaVersion": "0.1.0",
  "page": {
    "id": "simpleFormExample",
    "title": "Simple Form"
  },
  "state": {
    "name": "",
    "submittedName": ""
  },
  "data": {
    "intro": "这个示例展示 input、button、setState 和 state 绑定。"
  },
  "actions": {
    "updateName": {
      "type": "setState",
      "payload": {
        "path": "name",
        "value": "{{ context.value }}"
      }
    },
    "submitName": {
      "type": "setState",
      "payload": {
        "path": "submittedName",
        "value": "{{ state.name }}"
      }
    },
    "clearName": {
      "type": "setState",
      "payload": {
        "name": "",
        "submittedName": ""
      }
    }
  },
  "root": {
    "id": "simpleFormRoot",
    "type": "card",
    "kind": "page",
    "layout": {
      "mode": "block",
      "gap": "lg"
    },
    "children": [
      {
        "id": "formHeading",
        "type": "card",
        "kind": "display",
        "component": {
          "type": "heading",
          "props": {
            "level": 2,
            "text": "基础表单",
            "subtitle": "{{ data.intro }}"
          }
        }
      },
      {
        "id": "formSurface",
        "type": "card",
        "kind": "form",
        "component": {
          "type": "cardSurface",
          "props": {
            "title": "填写信息"
          }
        },
        "children": [
          {
            "id": "nameInput",
            "type": "card",
            "kind": "form",
            "component": {
              "type": "input",
              "props": {
                "name": "name",
                "label": "姓名",
                "modelValue": "{{ state.name }}",
                "placeholder": "请输入姓名",
                "clearable": true
              },
              "events": {
                "input": "updateName"
              }
            }
          },
          {
            "id": "previewText",
            "type": "card",
            "kind": "display",
            "component": {
              "type": "text",
              "props": {
                "tone": "muted",
                "text": "当前输入：{{ state.name }}"
              }
            }
          }
        ],
        "slots": {
          "actions": [
            {
              "id": "submitButton",
              "type": "card",
              "kind": "action",
              "component": {
                "type": "button",
                "props": {
                  "label": "提交",
                  "variant": "primary"
                },
                "events": {
                  "click": "submitName"
                }
              }
            },
            {
              "id": "clearButton",
              "type": "card",
              "kind": "action",
              "component": {
                "type": "button",
                "props": {
                  "label": "清空",
                  "variant": "secondary"
                },
                "events": {
                  "click": "clearName"
                }
              }
            }
          ],
          "footer": [
            {
              "id": "submitResultText",
              "type": "card",
              "kind": "display",
              "visible": "{{ state.submittedName }}",
              "component": {
                "type": "text",
                "props": {
                  "tone": "accent",
                  "text": "已提交：{{ state.submittedName }}"
                }
              }
            }
          ]
        }
      }
    ]
  }
}
